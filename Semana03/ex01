
valor = float(input("Digite o valor do produto: "))

# > 1000: 5% de juros e 2x
# < 1000: 2% de desconto a vista 

# if valor <= 1000:
if valor > 1000:
    novo_valor = valor * 1.05
    parcela = novo_valor / 2
    print("Novo valor: R$", novo_valor) 
    print ("Acrescimo: ", novo_valor - valor)
    print("Valor da parcela: R$", parcela)
else:
    novo_valor = valor * 0.98
    print("Valor a vista: R$", novo_valor)
    print ("Desconto: ", valor - novo_valor)
