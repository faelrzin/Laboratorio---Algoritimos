
morangos = float(input("Digite a quantidade de morangos em kg: "))
macas = float(input("Digite a quantidade de maçãs em kg: "))

# Preço do morango
if morangos <= 5:
    preco_morango = 2.50
else:
    preco_morango = 2.20

# Preço da maçã
if macas <= 5:
    preco_maca = 1.80
else:
    preco_maca = 1.50

valor_morangos = morangos * preco_morango
valor_macas = macas * preco_maca
valor_total = valor_morangos + valor_macas

# Desconto de 10%
if (morangos + macas) > 8 or valor_total > 25:
    desconto = valor_total * 0.10
else:
    desconto = 0

valor_final = valor_total - desconto

print(f"Valor dos morangos: R$ {valor_morangos:.2f}")
print(f"Valor das maçãs: R$ {valor_macas:.2f}")
print(f"Valor total: R$ {valor_total:.2f}")
print(f"Desconto: R$ {desconto:.2f}")
print(f"Valor a pagar: R$ {valor_final:.2f}")
