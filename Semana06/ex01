
qntotal = 0
quantidade = 0
maior = 0
menor = 0
media = 0

while quantidade < 7:
    producao = float(input(f"Digite a quantidade de quilos produzidos no dia {quantidade + 1}: "))
    qntotal += producao
    
    if quantidade == 0:
        maior = producao
        menor = producao
        dia_maior = quantidade + 1
        dia_menor = quantidade + 1
    else:
        if producao > maior:
            maior = producao
            dia_maior = quantidade + 1
        if producao < menor:
            menor = producao
            dia_menor = quantidade + 1
            
    quantidade += 1
    media = qntotal / 7

print("Quantidade total produzida na semana:", qntotal, "quilos")
print("Dia de maior produção:", dia_maior, "-", maior, "quilos")
print("Dia de menor produção:", dia_menor, "-", menor, "quilos")
print("Média diária de produção:", f"{media:.2f}", "quilos")
