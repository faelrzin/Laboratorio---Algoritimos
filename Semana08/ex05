maior_idade = 0

olhos_azuis = 0
olhos_verdes = 0
olhos_castanhos = 0

cabelos_loiros = 0
cabelos_castanhos = 0
cabelos_pretos = 0

masculino = 0
feminino = 0

verdes_pretos = 0

for i in range(15):
    print("\nPessoa", i + 1)

    sexo = input("Digite o sexo (M/F): ").upper()
    olhos = input("Digite a cor dos olhos (A/V/C): ").upper()
    cabelos = input("Digite a cor dos cabelos (L/C/P): ").upper()
    idade = int(input("Digite a idade: "))

    # Maior idade
    if idade > maior_idade:
        maior_idade = idade

    # Sexo
    if sexo == "M":
        masculino += 1
    elif sexo == "F":
        feminino += 1

    # Cor dos olhos
    if olhos == "A":
        olhos_azuis += 1
    elif olhos == "V":
        olhos_verdes += 1
    elif olhos == "C":
        olhos_castanhos += 1

    # Cor dos cabelos
    if cabelos == "L":
        cabelos_loiros += 1
    elif cabelos == "C":
        cabelos_castanhos += 1
    elif cabelos == "P":
        cabelos_pretos += 1

    # Pessoas entre 18 e 35 anos, olhos verdes e cabelos pretos
    if 18 <= idade <= 35 and olhos == "V" and cabelos == "P":
        verdes_pretos += 1


# Porcentagens
porc_azuis = (olhos_azuis / 15) * 100
porc_verdes = (olhos_verdes / 15) * 100
porc_castanhos_olhos = (olhos_castanhos / 15) * 100

porc_loiros = (cabelos_loiros / 15) * 100
porc_castanhos_cabelos = (cabelos_castanhos / 15) * 100
porc_pretos = (cabelos_pretos / 15) * 100

porc_masculino = (masculino / 15) * 100
porc_feminino = (feminino / 15) * 100


# Resultados
print("\n========== RESULTADOS ==========")

print("Maior idade do grupo:", maior_idade)

print(
    "Quantidade de pessoas entre 18 e 35 anos, "
    "com olhos verdes e cabelos pretos:",
    verdes_pretos
)

print("\nPorcentagem por cor dos olhos:")
print("Azuis:", porc_azuis, "%")
print("Verdes:", porc_verdes, "%")
print("Castanhos:", porc_castanhos_olhos, "%")

print("\nPorcentagem por cor dos cabelos:")
print("Loiros:", porc_loiros, "%")
print("Castanhos:", porc_castanhos_cabelos, "%")
print("Pretos:", porc_pretos, "%")

print("\nPorcentagem por sexo:")
print("Masculino:", porc_masculino, "%")
print("Feminino:", porc_feminino, "%")
