
n1 = float(input("Força 1: "))
n2 = float(input("Força 2: "))
n3 = float(input("Força 3: "))

if n1 + n2 > n3 and n1 + n3 > n2 and n2 + n3 > n1:
    if n1 == n2 == n3:
        print("Simetrico")
    elif n1 == n2 or n2 == n3 or n1 == n3:
        print ("Parcialmente simetrico")
    else:
        print ("Três forças diferentes")
else:
    print ("Não há equilibrio")
