def converter_horario(hora, minuto):
    if hora < 0 or hora > 23 or minuto < 0 or minuto > 59:
        return None

    periodo = "A.M." if hora < 12 else "P.M."
    hora_12 = hora % 12

    if hora_12 == 0:
        hora_12 = 12

    return hora_12, minuto, periodo


def apresentar_horario(horario):
    if horario is None:
        print("Horário inválido. Informe uma hora entre 0 e 23 e minutos entre 0 e 59.")
        return

    hora, minuto, periodo = horario
    print(f"{hora}:{minuto:02d} {periodo}")


hora = int(input("Digite a hora (0 a 23): "))
minuto = int(input("Digite os minutos (0 a 59): "))

horario_convertido = converter_horario(hora, minuto)
apresentar_horario(horario_convertido)
