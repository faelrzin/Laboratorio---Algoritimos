Terceira Questão
opcao = 0
total_gasolina = 0
total_diesel = 0

while opcao != 2:
    print("\n1 - Vender combustível")
    print("2 - Sair")
    opcao = int(input("Escolha uma opção: "))

    if opcao == 1:
        print("\n1 - Gasolina - R$ 6,89")
        print("2 - Diesel - R$ 4,80")

        combustivel = int(input("Escolha o combustível: "))
        litros = float(input("Quantidade de litros: "))

        if combustivel == 1:
            preco = 6.89
            total_gasolina += litros
        elif combustivel == 2:
            preco = 4.80
            total_diesel += litros
        else:
            print("Opção de combustível inválida!")
            continue

        valor = litros * preco
        print("Valor do abastecimento: R$", valor)

        pagamento = float(input("Valor pago: R$ "))

        if pagamento >= valor:
            print("Troco: R$", pagamento - valor)
        else:
            print("Faltou: R$", valor - pagamento)

    elif opcao != 2:
        print("Opção inválida!")

print("\nTotal de gasolina vendido:", total_gasolina, "litros")
print("Total de diesel vendido:", total_diesel, "litros")
print("Sistema encerrado.")

